{
  "info": {
    "name": "Hotel Booking API",
    "description": "End-to-end requests for the hotel booking backend, using the demo data from data.sql.\n\n1. `docker compose up -d`\n2. `RATE_LIMIT_PER_MINUTE=1000 ./mvnw spring-boot:run` (default limit is 10/min)\n3. Run the collection top to bottom (Collection Runner) \u2014 tokens, ids and dates are filled in automatically.\n\nDemo logins: alice@example.com / bob@example.com \u2192 password123, admin@example.com \u2192 admin123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request: a unique id per run + a future Mon->Wed stay (2 weekday nights).",
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", Date.now().toString());",
          "}",
          "const pad = n => String(n).padStart(2, \"0\");",
          "const fmt = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;",
          "const d = new Date();",
          "d.setDate(d.getDate() + (((8 - d.getDay()) % 7) || 7) + 7);",
          "const out = new Date(d);",
          "out.setDate(d.getDate() + 2);",
          "pm.collectionVariables.set(\"checkIn\", fmt(d));",
          "pm.collectionVariables.set(\"checkOut\", fmt(out));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "checkIn",
      "value": ""
    },
    {
      "key": "checkOut",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "aliceToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "hotelId",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Setup",
      "description": "",
      "item": [
        {
          "name": "New test run (reset run id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/public/health",
            "description": "Run this first. Generates a fresh runId so the registered user / hotel names are unique."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
