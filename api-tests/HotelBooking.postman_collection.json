    {
      "name": "6. Bookings",
      "description": "",
      "item": [
        {
          "name": "Create booking (2 nights x 100 + 30 breakfast)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "postman-{{runId}}-1"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": {{roomId}},\n  \"checkIn\": \"{{checkIn}}\",\n  \"checkOut\": \"{{checkOut}}\",\n  \"addOns\": [\"BREAKFAST\"],\n  \"paymentMethod\": \"UPI\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"total is 230\", () => pm.expect(pm.response.json().totalAmount).to.eql(230));",
                  "pm.collectionVariables.set(\"bookingId\", pm.response.json().bookingId);"
                ]
              }
            }
          ]
        },
