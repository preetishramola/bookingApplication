# Caddy gets and renews a Let's Encrypt certificate for APP_DOMAIN automatically
# (ports 80 and 443 must be open in the EC2 security group).
# One domain serves both: /api/* goes to Spring Boot, everything else is the React app.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy app:8080
	}

	# Only the health endpoint of Spring Actuator is public
	handle /actuator/health {
		reverse_proxy app:8080
	}
	handle /actuator/* {
		respond 404
	}

	# Built JS/CSS have content hashes in their names: cache forever, and a missing one is a real 404
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# React app: real files first, otherwise index.html so client-side routes (/hotels/3, /bookings) work on refresh
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
