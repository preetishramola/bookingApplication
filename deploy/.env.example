# Copy to ~/hotelbooking/.env on the server (NEVER commit the real .env):
#   cp deploy/.env.example .env && nano .env
# Generate the two secrets on the server with:
#   openssl rand -hex 24    (DB_PASSWORD)
#   openssl rand -hex 32    (JWT_SECRET, must be at least 32 characters)

# Your free DuckDNS subdomain (or your own domain) pointing at the EC2 Elastic IP
APP_DOMAIN=yourname.duckdns.org

# Images pushed by the GitHub Actions workflow (owner/repo must be lowercase)
APP_IMAGE=ghcr.io/preetishramola/bookingapplication-app:latest
DB_IMAGE=ghcr.io/preetishramola/bookingapplication-db:latest
WEB_IMAGE=ghcr.io/preetishramola/bookingapplication-web:latest

DB_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters

# Region for Amazon Bedrock (Titan Text Embeddings V2); keep it the same as the EC2 region
AWS_REGION=ap-south-1

# Requests per minute per client IP (the React app makes a few calls per page)
RATE_LIMIT_PER_MINUTE=120
